# Supabase → bouton "Connect" en haut du dashboard du projet.
# App (Vercel, serverless): "Transaction pooler", port 6543.
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres?sslmode=require
# Migrations (npm run db:push): "Session pooler", port 5432.
DIRECT_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres?sslmode=require

# Secret used once to create the first admin account at /invite/<BOOTSTRAP_TOKEN>.
# Only works while there are no users in the database. Generate with: openssl rand -hex 24
BOOTSTRAP_TOKEN=change-me
